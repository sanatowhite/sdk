<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".AppTemplateApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.AppTemplate"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppTemplate.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 反馈页的 FileProvider(${applicationId}.feedback.fileprovider)+
             SEND_MULTIPLE 的 <queries> 声明都在 :feature-feedback 自己的
             manifest 里,manifest merge 自动生效,这里不需要重复声明。 -->
    </application>
</manifest>
